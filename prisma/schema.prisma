// This is the single source of truth for the database schema.
// Generated client: @prisma/client
// DB: PostgreSQL 16
//
// Implements the data-lead entity model (brief.md "Data-Lead Output") and the
// security requirements ADR-012 (refresh-token rotation + reuse detection),
// ADR-013 (object-level authz / IDOR resistance), ADR-016 (UUID PKs),
// ADR-017 (3NF + native enums), ADR-018 (single Postgres store).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Application authorization role (abuse-prevention, ADR-030). The UNFORGEABLE
/// source of truth for whether a user is an admin. The JWT `role` claim is
/// derived from THIS column at token issue, never from a request body — no API
/// route writes `role`, so there is no self-promotion path. Enum (not boolean)
/// for future extensibility (e.g. MODERATOR). Intentionally NOT indexed: a
/// 2-value column has near-zero selectivity (the planner would seq-scan anyway).
enum UserRole {
  USER
  ADMIN
}

/// Lifecycle of a flagged (suspected-abusive) URL submission (ADR-032).
/// State machine: screening flags a candidate → PENDING; an admin review moves
/// it to APPROVED (terminal; a real ShortUrl is minted) or REJECTED (terminal;
/// nothing minted). approve/reject are only valid from PENDING (else 409).
enum FlagState {
  PENDING
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// A registered application user. Owns tasks and can be assigned tasks.
/// Email is stored lowercase (case-insensitivity enforced in users.service —
/// lowercase-on-write, NOT citext; see data-lead open decision + ADR-017).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  // RFC 5321 max email length is 254 chars; 320 leaves headroom. Unique index
  // (login lookup + uniqueness invariant) is auto-created by @unique.
  email        String   @unique @db.VarChar(320)
  // bcrypt hash is fixed-length 60 chars; 72 leaves headroom (ADR-008).
  passwordHash String   @map("password_hash") @db.VarChar(72)
  name         String   @db.VarChar(100)
  // Authorization role (ADR-030). NOT NULL DEFAULT USER backfills every existing
  // row to USER at migration time (metadata-only ALTER, Postgres 11+, no table
  // rewrite) so the existing test suite stays green — no test sees an admin
  // unless it explicitly creates one. Admin bootstrap is an out-of-band UPDATE.
  role         UserRole @default(USER)
  /// Google OAuth2 subject identifier (the `sub` claim) — the IMMUTABLE, stable
  /// join key for "Sign in with Google" (ADR-036 §1, ADR-041). NULL for every
  /// password-only account. UNIQUE: one Google identity maps to exactly one
  /// account — the takeover backstop (ADR-036 §5). Plain @unique is correct: a
  /// Postgres UNIQUE treats NULLs as distinct, so the many NULL (password-only)
  /// rows coexist while every non-null sub is unique — same proven pattern as
  /// FlaggedUrl.proposedCode. Treated as an OPAQUE string (never parsed numeric);
  /// VarChar(255) is Google's documented max with headroom.
  googleId     String?  @unique @map("google_id") @db.VarChar(255)
  /// The email Google returned at link/create time — stored for AUDIT/DISPLAY
  /// ONLY (ADR-036 §6, ADR-041). NOT unique (it may legitimately equal another
  /// account's primary email — the ADR-036 email_verified ladder resolves that)
  /// and NOT indexed (no query is keyed by it; login joins on googleId, link
  /// joins on the primary `email`). VarChar(320) mirrors the `email` column.
  googleEmail  String?  @map("google_email") @db.VarChar(320)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Tasks created by this user (FK Task.ownerId, NOT NULL, CASCADE delete).
  ownedTasks    Task[]         @relation("TaskOwner")
  /// Tasks assigned to this user (FK Task.assigneeId, NULLABLE, SET NULL).
  assignedTasks Task[]         @relation("TaskAssignee")
  refreshTokens RefreshToken[]
  /// Short URLs created by this user (FK ShortUrl.ownerId, NOT NULL, CASCADE delete).
  shortUrls     ShortUrl[]
  /// Blocklist entries this (admin) user added (FK BlockedDomain.addedByUserId,
  /// NULLABLE, SET NULL — the block outlives the curator who added it).
  blockedDomainsAdded BlockedDomain[] @relation("BlockedDomainAddedBy")
  /// URLs this user submitted that got flagged (FK FlaggedUrl.ownerId, NOT NULL,
  /// CASCADE — deleting the submitter removes their pending submissions).
  flaggedUrls         FlaggedUrl[]    @relation("FlaggedUrlOwner")
  /// Flag reviews this (admin) user performed (FK FlaggedUrl.reviewedByUserId,
  /// NULLABLE, SET NULL — preserve the review record if the reviewer is deleted).
  reviewedFlaggedUrls FlaggedUrl[]    @relation("FlaggedUrlReviewedBy")

  @@map("users")
}

/// A task created by a user (owner) and optionally assigned to another user.
/// Authorization is object-level (ADR-013): owner OR assignee may read/update;
/// owner ONLY may reassign/delete.
model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  ownerId    String  @map("owner_id") @db.Uuid
  assigneeId String? @map("assignee_id") @db.Uuid

  owner    User  @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // ── Indexes (data-lead index strategy) ────────────────────────────────────
  // Composite serves "tasks owned by me", owner+status, and owner+status+priority
  // filtered lists via leftmost-prefix matching. Makes a standalone (ownerId)
  // and (ownerId, status) index redundant — those are intentionally omitted to
  // reduce write amplification (data-lead instruction; EXPLAIN-validated below).
  @@index([ownerId, status, priority])
  // priority is NOT a prefix of the 3-col index, so this is required for
  // owner + priority filtering without status.
  @@index([ownerId, priority])
  // "Tasks assigned to me". Partial (WHERE assignee_id IS NOT NULL) is applied
  // in migration 002 to skip the many NULL-assignee rows.
  @@index([assigneeId])

  @@map("tasks")
}

/// Refresh tokens for auth session management (ADR-005, ADR-012).
/// Only the SHA-256 HASH of the token is stored, never plaintext. Tokens are
/// grouped into a rotation `family`; each token carries a unique `jti`. On every
/// refresh the presented token is rotated (new jti, same family); reuse of a
/// consumed token => assume theft => revoke the whole family.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  // SHA-256 hex digest = 64 chars. Unique: a given token hash maps to one row.
  hashedToken String    @unique @map("hashed_token") @db.VarChar(64)
  // UUID identifying the rotation chain (one login session).
  family      String    @db.Uuid
  // UUID unique per individual token; the unique business key.
  jti         String    @unique @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  // null = active; set = revoked/consumed.
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reuse detection within a rotation family (ADR-012). Also enforces the
  // (family, jti) uniqueness invariant.
  @@unique([family, jti])
  // "tokens by user" — revoke-all-by-user / logout-all-devices.
  @@index([userId])
  // Expired-token cleanup cron: DELETE WHERE expires_at < now().
  @@index([expiresAt])

  @@map("refresh_tokens")
}

/// A shortened URL owned by a user (URL Shortener feature — ADR-022/023/024).
/// `code` is the public, non-enumerable business key (6-char base62, CSPRNG-
/// generated in the service per ADR-022); `id` (UUID, ADR-016) is the opaque
/// internal PK. The redirect path looks rows up by `code` (UNIQUE), never by id.
/// Authorization is object-level (ADR-013/021): owner ONLY may read stats or
/// delete; 404-not-403 for non-owners. `original_url` is the only client-supplied
/// field and is SSRF-validated (ADR-019) before persistence.
model ShortUrl {
  id             String    @id @default(uuid()) @db.Uuid
  // 6-char base62 [A-Za-z0-9]; UNIQUE backs both the hot redirect lookup and the
  // ADR-022 insert-retry-on-collision (P2002) uniqueness guarantee.
  code           String    @unique @db.VarChar(6)
  // Arbitrary-length destination; TEXT (no business length cap at the column —
  // the 2048-byte abuse cap is enforced in validation, ADR-019/M2).
  originalUrl    String    @map("original_url") @db.Text
  ownerId        String    @map("owner_id") @db.Uuid
  // Atomic increment on each redirect (ADR-023), never read-modify-write.
  clickCount     Int       @default(0) @map("click_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  // null until the first redirect; set together with the click_count increment.
  lastAccessedAt DateTime? @map("last_accessed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Deleting a user removes all their short URLs (no orphaned links).
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // ── Indexes (data-lead index strategy, ADR-024 + ADR-032) ─────────────────
  // UNIQUE(code) is created by @unique above: the HOT path — WHERE code = ? on
  // every GET /:code redirect and GET /:code/stats. EXPLAIN must show Index Scan.
  // Composite (owner_id, created_at): serves BOTH the daily-quota range COUNT
  // (ADR-032: WHERE owner_id = ? AND created_at >= date_trunc('day', now() …))
  // AND, via its leftmost prefix (owner_id), the owner-only authz on stats/delete
  // and "list my URLs". This REPLACES the standalone (owner_id) index from
  // migration 003 — the prefix subsumes it, so net index count stays flat.
  @@index([ownerId, createdAt])

  @@map("short_urls")
}

/// A domain on the abuse blocklist (ADR-031). `domain` stores the CANONICAL
/// REGISTRABLE form (lowercase + IDN→punycode + trailing-dot stripped + reduced
/// to the registrable eTLD+1). Subdomain coverage is achieved by canonicalizing
/// BOTH sides and matching by EQUALITY (WHERE domain = $canonical), never by a
/// suffix LIKE — equality is index-backed and bypass-proof (a.b.evil.com → its
/// registrable form evil.com → hits the single stored row). The hot path is one
/// UNIQUE-index equality probe on every POST /shorten. The block is immutable
/// (add/remove only) — hence no `updated_at`.
model BlockedDomain {
  id        String   @id @default(uuid()) @db.Uuid
  // Canonical registrable domain. RFC 1035 caps a full domain name at 253 chars.
  // UNIQUE backs the hot equality probe AND enforces "one row per domain".
  domain    String   @unique @db.VarChar(253)
  // Free-text curator note (why it was blocked). Optional.
  note      String?  @db.Text
  // The admin who added the entry. NULLABLE + SET NULL: the block must outlive
  // the curator (deleting the admin must NOT delete the blocklist entry).
  addedByUserId String? @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  addedBy User? @relation("BlockedDomainAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@map("blocked_domains")
}

/// A URL submission that automated screening flagged as suspected-abusive
/// (ADR-032). It is held here (NOT minted as a live ShortUrl) until an admin
/// approves it. `short_urls` therefore stays "live-only" — the redirect path
/// needs no state filter. State machine + persistence rules: see FlagState.
model FlaggedUrl {
  id              String    @id @default(uuid()) @db.Uuid
  candidateUrl    String    @map("candidate_url") @db.Text
  // Optional reserved short code (UNIQUE-when-present; multiple NULLs allowed by
  // Postgres). Supports both "reserve at flag" and "assign at approval" — the
  // exact timing is a backend AP-3 decision and does not change this shape.
  proposedCode    String?   @unique @map("proposed_code") @db.VarChar(6)
  ownerId         String    @map("owner_id") @db.Uuid
  // Screening confidence 0–100. SMALLINT (not Decimal/float): an exact integer
  // band for deterministic threshold comparisons. CHECK(0..100) in migration 004.
  confidenceScore Int       @map("confidence_score") @db.SmallInt
  state           FlagState @default(PENDING)
  flaggedReason   String    @map("flagged_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  // null until reviewed; set together with the terminal state transition.
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedByUserId String?  @map("reviewed_by_user_id") @db.Uuid

  // Submitter. CASCADE: deleting the user removes their pending submissions.
  owner      User  @relation("FlaggedUrlOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Reviewing admin. NULLABLE + SET NULL: preserve the review decision even if
  // the reviewer's account is later deleted.
  reviewedBy User? @relation("FlaggedUrlReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  // ── Indexes (data-lead index strategy, ADR-032) ───────────────────────────
  // Admin review queue: PARTIAL on PENDING only, ordered by created_at. The
  // partial predicate keeps the index tiny (terminal rows are excluded) and the
  // (state, created_at) order lets "PENDING oldest-first" read straight off the
  // index with NO Sort node. Mirrors the tasks(assignee_id) partial pattern.
  @@index([state, createdAt])
  // "my flagged submissions" + supports the owner CASCADE FK.
  @@index([ownerId])

  @@map("flagged_urls")
}
