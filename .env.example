# Server
PORT=3000
NODE_ENV=development

# Database
# Connection pool is configured via DATABASE_URL query params (Prisma reads these):
#   connection_limit : max connections this app instance opens in its Prisma pool.
#                      Formula: (2 * core_count) + effective_spindle_count.
#                      Example below: 4-core box, SSD (spindle=1) => (2*4)+1 = 9.
#                      MUST satisfy: connection_limit * app_instances <= Postgres max_connections.
#   pool_timeout     : seconds Prisma waits for a free pooled connection before erroring (default 10).
#   connect_timeout  : seconds to wait establishing a new TCP/DB connection (default 5). Set explicitly.
# When fronting with PgBouncer (transaction mode) in prod: add &pgbouncer=true and set
# connection_limit=1 per instance (PgBouncer owns the real pool); see DB-Engineer Output in brief.md.
DATABASE_URL=postgresql://user:password@localhost:5432/taskmanagement?schema=public&connection_limit=9&pool_timeout=10&connect_timeout=5

# JWT (secrets MUST be at least 32 bytes; startup fails otherwise — H3)
# Use distinct, high-entropy values in every environment. Never commit real secrets.
JWT_SECRET=replace-with-a-random-string-at-least-32-bytes-long
JWT_REFRESH_SECRET=replace-with-a-different-random-32-byte-string-here
# Token lifetimes (ms-style strings: 15m, 7d, 1h, 30s).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Security
# bcrypt cost factor (10-14; 12 = OWASP recommendation, ADR-008).
BCRYPT_ROUNDS=12
# Comma-separated CORS/CSRF origin allowlist. Empty disables cross-origin
# requests (and skips the CSRF origin check). NEVER use "*" with credentials.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
